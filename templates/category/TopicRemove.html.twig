<form method="post" action="{{ path('topic_remove', {'id': topic.id}) }}" onsubmit="return confirm('Do you really want to remove this category?');" class="delete-form">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete' ~ topic.id) }}">
    <button type="submit" class="btn btn-danger">Remove</button>
</form>

{% extends 'base.html.twig' %}

{% block title %}Topic Details{% endblock %}

{% block body %}
    <div class="content-wrapper">
        <h1 class="page-title text-center">Topic Details</h1>

        <table class="details-table">
            <tbody>
            <tr>
                <th>ID</th>
                <td>{{ topic.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ topic.label }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ topic.description }}</td>
            </tr>
            </tbody>
        </table>

        <div class="button-group text-center mt-4">
            <a href="{{ path('topic_index') }}" class="btn btn-secondary">Back to Overview</a>
            <a href="{{ path('topic_edit', {'id': topic.id}) }}" class="btn btn-primary">Edit</a>
        </div>

        <div class="delete-section text-center">
            {{ include('topic/_delete_form.html.twig') }}
        </div>
    </div>

    <style>
        .content-wrapper {
            max-width: 700px;
            margin: 0 auto;
            padding: 30px;
            background-color: #e8f5e9;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .page-title {
            font-size: 2.5rem;
            margin-bottom: 2rem;
            color: #333;
        }

        .details-table {
            width: 100%;
            margin-bottom: 20px;
            background-color: #fff;
            border-collapse: collapse;
        }

        .details-table th {
            background-color: #f1f1f1;
            font-weight: bold;
            padding: 10px;
            border-bottom: 1px solid #ddd;
        }

        .details-table td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            vertical-align: middle;
        }

        .btn {
            padding: 12px 24px;
            font-size: 16px;
            cursor: pointer;
            margin: 5px;
            width: 150px;
            border-radius: 6px;
            text-decoration: none;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
            border: none;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
            border: none;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        .text-center {
            text-align: center;
        }

        .button-group {
            margin-top: 20px;
        }

        .delete-section {
            margin-top: 20px;
        }

        .mt-4 {
            margin-top: 2rem;
        }
    </style>
{% endblock %}

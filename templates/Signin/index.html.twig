{% extends 'base.html.twig' %}

{% block title %}Sign In{% endblock %}

{% block body %}
    <div class="login-container d-flex flex-column align-items-center justify-content-center mt-5">
        {% if error %}
            <div class="alert alert-danger alert-dismissible fade show w-100" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post" class="login-form w-75 text-center">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-group mb-4">
                <label for="username" class="form-label">Email Address:</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" class="form-control text-center" required autofocus>
            </div>

            <div class="form-group mb-4">
                <label for="password" class="form-label">Password:</label>
                <input type="password" id="password" name="_password" class="form-control text-center" required>
            </div>

            <button type="submit" class="btn btn-lg btn-primary w-100">Sign In</button>
        </form>

        <div class="mt-3 w-75 text-center">
            <a href="{{ path('app_register') }}" class="btn btn-link">Create an Account</a>
            <br>
            <a href="{{ path('app_reset_password') }}" class="btn btn-link">Forgot Password?</a>
        </div>
    </div>

    <style>
        .login-container {
            width: 100%;
            max-width: 500px;
            padding: 25px;
            background-color: #e9ecef;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            margin: 0 auto;
        }

        .login-form {
            width: 100%;
        }

        .form-label {
            font-weight: bold;
            margin-bottom: 5px;
            color: #343a40;
        }

        .form-control {
            padding: 12px;
            font-size: 16px;
            border: 1px solid #ced4da;
            border-radius: 5px;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
            color: white;
            padding: 12px;
            font-size: 16px;
            border-radius: 5px;
            cursor: pointer;
        }

        .btn-primary:hover {
            background-color: #0056b3;
        }

        .btn-link {
            font-size: 14px;
            color: #007bff;
            text-decoration: none;
        }

        .btn-link:hover {
            text-decoration: underline;
        }

        .alert-danger {
            margin-bottom: 20px;
        }

        .alert-dismissible .btn-close {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            font-size: 16px;
        }
    </style>
{% endblock %}
